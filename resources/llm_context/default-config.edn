{:analysis
 {:include ["."]
  :exclude [".git" ".llm-context" "node_modules" "target" ".cpcache"
            "dist" "build" "out" ".shadow-cljs" ".cljs_node_repl" ".lsp"]
  :max-file-bytes 1048576}

 :store
 {:path ".llm-context/db"
  :max-transaction-weight 4000
  :minimum-free-space-bytes 10737418240
  :free-space-probe-path nil}

 :service
 {:watch true
  :watch-initial true
  :watch-debounce-ms 750
  :request-threads 4
  :request-queue-capacity 32}

 :semantic
 {:providers [:lateon-code]
  :lateon-code
  {:enabled true
   :mode :background
   :next-plaid-version "1.6.4"
   :next-plaid-command ["next-plaid-api"]
   :model "lightonai/LateOn-Code"
   :model-revision "734b659a57935ef50562d79581c3ff1f8d825c93"
   :model-path nil
   :quantization :int8
   :index-path ".llm-context/semantic/next-plaid"
   :index-name "llm-context-v4"
   :nbits 4
   :start-from-scratch 0
   :document-version 4
   :max-document-bytes 6000
   :chunk-overlap-lines 8
   :pool-factor 2
   :encoding-sessions 4
   :encoding-batch-size 1
   :model-document-length 2048
   :update-batch-size 32
   :update-concurrency 4
   :startup-timeout-ms 120000
   :health-timeout-ms 2000
   :update-timeout-ms 120000
   :query-timeout-ms 1500
   :candidate-count 50
   :n-ivf-probe 8
   :centroid-score-threshold nil
   :n-full-scores 4096
   :lease-ms 120000
   :visibility-timeout-ms 180000
   :visibility-poll-ms 250
   :idle-poll-ms 500
   :retry-base-ms 1000
   :retry-max-ms 60000
   :max-attempts 5}}

 :context
 {:default-max-tokens 8000
  :trace-depth 4
  :trace-limit 200
  :intent-source-preference :auto
  :intent-seed-mode :auto
  :intent-max-seeds 4
  :intent-rerank true
  :intent-candidate-count 100
  :candidate-reranker
  {:enabled true
   :mode :shadow
   :candidate-count 50
   :query-timeout-ms 5000
   :document-cache-size 2048}
  :query-router
  {:enabled true
   :next-plaid-version "1.6.4"
   :next-plaid-command ["next-plaid-api"]
   :model "mixedbread-ai/mxbai-edge-colbert-v0-32m"
   :model-revision "963e23afa1478d8bcc12e5d7115adcfdbd22c3af"
   :model-path nil
   :quantization :int8
   :index-path ".llm-context/query-router/next-plaid"
   :index-name "llm-context-query-shapes-v1"
   :nbits 4
   :start-from-scratch 0
   :pool-factor 1
   :encoding-sessions 1
   :encoding-batch-size 1
   :startup-timeout-ms 120000
   :health-timeout-ms 2000
   :update-timeout-ms 30000
   :query-timeout-ms 250
   :minimum-margin 0.02}
  :source-role-overrides []}}
