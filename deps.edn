{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        clj-kondo/clj-kondo {:mvn/version "2026.08.04"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.clojure/tools.reader {:mvn/version "1.6.0"}
        org.datalevin/datalevin-embedded {:mvn/version "1.0.2"}
        io.github.tree-sitter/jtreesitter {:mvn/version "0.26.1"}
        io.github.bonede/tree-sitter {:mvn/version "0.26.6"}}
 :aliases
 {:dev {:extra-paths ["dev"]}
  :test {:extra-paths ["test" "bench"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]}
  :bench {:extra-paths ["bench"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "llm-context.benchmark"]}
  :semantic-bench
  {:extra-paths ["bench"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "llm-context.semantic-benchmark"]}
  :validate-semantic-corpus
  {:extra-paths ["bench"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "llm-context.retrieval-corpus"]}
  :public-semantic-evaluation
  {:extra-paths ["bench"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "llm-context.public-semantic-evaluation"]}
  :qualify-providers
  {:extra-paths ["bench"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "llm-context.provider-qualification"]}
  :qualify-semantic-ingestion
  {:extra-paths ["bench"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "llm-context.semantic-ingestion-qualification"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
